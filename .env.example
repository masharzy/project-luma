# Runtime role with access only to app_auth. Never use an owner URL in production runtime.
DATABASE_URL=postgresql://luma_auth_runtime:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
APP_ORIGIN=http://localhost:3000
# Google Cloud web OAuth client. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Preferred email delivery: verified Resend sender. Server-only secrets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional SMTP fallback when RESEND_API_KEY is unset.
# SMTP sender credentials. Production requires TLS and a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JumpToNine <auth@example.com>
SMTP_REQUIRE_TLS=true
# Writing evaluation: Singapore pay-as-you-go key; never a Coding/Token Plan key.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Private Speaking recordings and cached examiner voice (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI evaluation lab only. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable; changing this key makes stored provider keys unreadable.
AI_LAB_MASTER_KEY=
# Optional server-only alternatives to admin-stored encrypted secrets:
GEMINI_API_KEY=
OPENROUTER_API_KEY=
