# Runtime role with access only to app_auth. Never use an owner URL in production runtime.
DATABASE_URL=postgresql://luma_auth_runtime:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
APP_ORIGIN=http://localhost:3000
# Google Cloud web OAuth client. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP sender credentials. Production requires TLS and a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Luma <auth@example.com>
SMTP_REQUIRE_TLS=true
