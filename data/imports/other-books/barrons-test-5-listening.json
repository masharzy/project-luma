-audio.engnovatemedia.com/3212574-barrons-ielts-practice-exams-academic-listening-test-5-4.mp3","question_groups":[{"id":"en-barrons-t5-l-g4-0","type":"source_html","ieltsQuestionType":"matching_features","instructions":"","sourceHeading":"Questions 31-35","sourceHtml":"<div class=\"source-question-section-content\"><p>Choose the correct letter, A, B, or C.</p></div><div class=\"source-questions\"><div class=\"source-question-item\"><span><strong class=\"source-question-number\">31</strong> The tomato originally came from</span><div class=\"source-option\"><label class=\"source-option-letter\">A</label><span data-luma-question=\"en-barrons-t5-l-q31\" data-luma-kind=\"radio\" data-luma-option=\"A\"></span><span>Mexico.</span></div><div class=\"source-option\"><label class=\"source-option-letter\">B</label><span data-luma-question=\"en-barrons-t5-l-q31\" data-luma-kind=\"radio\" data-luma-option=\"B\"></span><span>Spain.</span></div><div class=\"source-option\"><label class=\"source-option-letter\">C</label><span data-luma-question=\"en-barrons-t5-l-q31\" data-luma-kind=\"radio\" data-luma-option=\"C\"></span><span>Peru.</span></div></div><div class=\"source-question-item\"><span><strong class=\"source-question-number\">32</strong> The original color of the tomato was</span><div class=\"source-option\"><label class=\"source-option-letter\">A</label><span data-luma-question=\"en-barrons-t5-l-q32\" data-luma-kind=\"radio\" data-luma-option=\"A\"></span><span>red.</span></div><div class=\"source-option\"><label class=\"source-option-letter\">B</label><span data-luma-question=\"en-barrons-t5-l-q32\" data-luma-kind=\"radio\" data-luma-option=\"B\"></span><span>green.</span></div><div class=\"source-option\"><label class=\"source-option-letter\">C</label><span data-luma-question=\"en-barrons-t5-l-q32\" data-luma-kind=\"radio\" data-luma-option=\"C\"></span><span>yellow.</span></div></div><div class=\"source-question-item\"><span><strong class=\"source-question-number\">33</